# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:replace-me
# Telegram id админов через запятую, например 111111111,222222222.
# Пусто = админ-панель выключена
ADMIN_IDS=
# Часовой пояс расписания (IANA), в нём считаются рабочие часы и напоминания
TIMEZONE=Europe/Moscow
# Шаг сетки слотов, минут
SLOT_STEP_MIN=30
# За сколько часов до приёма ещё можно отменить или перенести запись
CANCEL_DEADLINE_HOURS=2
# БД SQLite. В Docker путь ./data/... лежит в томе /app/data, менять не нужно
DATABASE_URL=sqlite+aiosqlite:///./data/bookings.db
# Необязательно: экспорт в Google Таблицу.
# Локально: credentials/service-account.json
# В Docker (папка ./credentials смонтирована только для чтения):
#   /app/credentials/service-account.json
GSHEETS_CREDENTIALS_PATH=
# ID таблицы из её адреса: docs.google.com/spreadsheets/d/<ID>/edit
GSHEETS_SPREADSHEET_ID=
